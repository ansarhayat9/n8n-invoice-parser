        "options": {}
      },
      "id": "6049b085-dc26-4ec0-a7db-328210ba0033",
      "name": "Download PDF",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        640,
        320
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "624c4d68-16eb-48ce-be6d-ce8f029bd6e2",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        864,
        320
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"invoice_number\": {\n      \"type\": \"string\",\n      \"description\": \"Invoice number or ID exactly as printed\"\n    },\n    \"sender_name\": {\n      \"type\": \"string\",\n      \"description\": \"Company or person that issued the invoice\"\n    },\n    \"sender_email\": {\n      \"type\": \"string\",\n      \"description\": \"Email address of the issuer\"\n    },\n    \"invoice_date\": {\n      \"type\": \"string\",\n      \"description\": \"Invoice date in YYYY-MM-DD\"\n    },\n    \"due_date\": {\n      \"type\": \"string\",\n      \"description\": \"Payment due date in YYYY-MM-DD\"\n    },\n    \"currency\": {\n      \"type\": \"string\",\n      \"description\": \"3-letter currency code such as USD, PKR, EUR\"\n    },\n    \"total_amount\": {\n      \"type\": \"number\",\n      \"description\": \"Final total amount due as a plain number, no currency symbol\"\n    }\n  }\n}",
        "options": {
          "systemPromptTemplate": "You are an accurate invoice data extractor. Extract only values that are explicitly written in the text. If a field is not present, omit it. Never guess or invent values. Dates must be YYYY-MM-DD. total_amount is the final amount due as a plain number."
        }
      },
      "id": "28d536c2-2b80-4a95-9ef8-4c4fc5827fc9",
      "name": "Extract Invoice Fields",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1088,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "temperature": 0
        }
      },
      "id": "a89f683c-079c-4370-863f-28e80e387aa8",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        1104,
        560
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output || {};\nconst file = $('Google Drive Trigger').item.json;\nconst clean = (v) => (v === null || v === undefined) ? '' : String(v).trim();\n\nconst amount = parseFloat(String(out.total_amount ?? '').replace(/[^0-9.\\-]/g, ''));\nconst invoiceNumber = clean(out.invoice_number);\nconst isValid = invoiceNumber !== '' && Number.isFinite(amount);\n\nreturn {\n  json: {\n    invoice_number: invoiceNumber,\n    sender_name: clean(out.sender_name),\n    sender_email: clean(out.sender_email).toLowerCase(),\n    invoice_date: clean(out.invoice_date),\n    due_date: clean(out.due_date),\n    currency: clean(out.currency).toUpperCase(),\n    total_amount: Number.isFinite(amount) ? amount : '',\n    file_name: clean(file.name),\n    file_link: file.webViewLink || `https://drive.google.com/file/d/${file.id}/view`,\n    processed_at: new Date().toISOString(),\n    is_valid: isValid\n  }\n};"
      },
      "id": "1fd4cc0a-ff1c-4860-b858-6ed3e101296a",
      "name": "Clean and Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c2000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.is_valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "817e1b9f-429e-40bc-bc40-b2330db84abe",
      "name": "Data Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1664,
        320
      ]
    },
    {
      "parameters": {
