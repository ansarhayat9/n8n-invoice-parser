            "Currency": "={{ $json.currency }}",
            "Total Amount": "={{ $json.total_amount }}",
            "File Name": "={{ $json.file_name }}",
            "File Link": "={{ $json.file_link }}",
            "Processed At": "={{ $json.processed_at }}"
          },
