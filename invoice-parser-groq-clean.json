    {
      "parameters": {
        "sendTo": "billing@example.com",
        "subject": "={{ 'New Invoice Recorded: ' + $('Clean and Validate').item.json.invoice_number + ' (' + $('Clean and Validate').item.json.sender_name + ')' }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222\"><p>Dear Billing Team,</p><p>A new invoice has been received and recorded in the Invoice Database.</p><table style=\"border-collapse:collapse\"><tr><td style=\"padding:6px 12px;border:1px solid #ddd;background:#f6f6f6\"><b>Invoice Number</b></td><td style=\"padding:6px 12px;border:1px solid #ddd\">{{ $('Clean and Validate').item.json.invoice_number }}</td></tr><tr><td style=\"padding:6px 12px;border:1px solid #ddd;background:#f6f6f6\"><b>Sender</b></td><td style=\"padding:6px 12px;border:1px solid #ddd\">{{ $('Clean and Validate').item.json.sender_name }}</td></tr><tr><td style=\"padding:6px 12px;border:1px solid #ddd;background:#f6f6f6\"><b>Sender Email</b></td><td style=\"padding:6px 12px;border:1px solid #ddd\">{{ $('Clean and Validate').item.json.sender_email }}</td></tr><tr><td style=\"padding:6px 12px;border:1px solid #ddd;background:#f6f6f6\"><b>Total Amount</b></td><td style=\"padding:6px 12px;border:1px solid #ddd\">{{ $('Clean and Validate').item.json.currency }} {{ $('Clean and Validate').item.json.total_amount }}</td></tr><tr><td style=\"padding:6px 12px;border:1px solid #ddd;background:#f6f6f6\"><b>Invoice Date</b></td><td style=\"padding:6px 12px;border:1px solid #ddd\">{{ $('Clean and Validate').item.json.invoice_date }}</td></tr><tr><td style=\"padding:6px 12px;border:1px solid #ddd;background:#f6f6f6\"><b>Due Date</b></td><td style=\"padding:6px 12px;border:1px solid #ddd\">{{ $('Clean and Validate').item.json.due_date }}</td></tr></table><p><a href=\"{{ $('Clean and Validate').item.json.file_link }}\">View original PDF</a> &nbsp;|&nbsp; <a href=\"https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit\">Open Invoice Database</a></p><p>Best regards,<br>Invoice Automation</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
