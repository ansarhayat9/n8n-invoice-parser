{
  "name": "Invoice Parser (Drive -> Groq -> Sheets -> Gmail)",
  "nodes": [
    {
      "parameters": {
        "content": "## Invoice Parser (Groq, free)\n1. Set credentials on Drive, Sheets, Gmail and Groq nodes\n2. Drive Trigger: pick the folder to watch\n3. Sheets nodes: pick your sheet; row 1 headers must match: Invoice Number, Sender Name, Sender Email, Invoice Date, Due Date, Currency, Total Amount, File Name, File Link, Processed At\n4. Gmail nodes: set the billing team address\n5. Replace YOUR_GOOGLE_SHEET_ID in the success email link ",
        "height": 260,
        "width": 520
      },
      "id": "773f8c56-0d2a-4be0-80d6-a9ae329f5b1f",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "YOUR_DRIVE_FOLDER_ID",
          "mode": "id"
        },
        "event": "fileCreated",
        "options": {}
      },
      "id": "f19c9230-8aa9-4b42-b821-691f296a75dd",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        208,
        352
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "application/pdf",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "984d9c81-cfb9-4186-8237-57af16558829",
      "name": "Is PDF?",
