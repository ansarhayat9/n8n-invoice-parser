        "subject": "={{ 'Invoice needs manual review: ' + $('Clean and Validate').item.json.file_name }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222\"><p>Dear Billing Team,</p><p>A new file was uploaded but the invoice number or total amount could not be read reliably. It was <b>not</b> added to the Invoice Database. Please review it manually.</p><p>File: <a href=\"{{ $('Clean and Validate').item.json.file_link }}\">{{ $('Clean and Validate').item.json.file_name }}</a></p><p>Best regards,<br>Invoice Automation</p></div>",
        "options": {
